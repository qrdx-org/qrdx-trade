# One deployment serves mainnet (/api/v1) and testnet (/api/v1-test); the pages
# follow the wallet's network. Which network each slot serves:
# NEXT_PUBLIC_QRDX_MAIN_NETWORK=mainnet
# NEXT_PUBLIC_QRDX_TEST_NETWORK=testnet      # set to "local" to develop against scripts/local-node

# Node endpoints per slot (defaults per network in lib/config.ts)
# QRDX_MAIN_RPC_URL=https://rpc.qrdx.org
# QRDX_MAIN_NODE_URL=https://node.qrdx.org
# QRDX_TEST_RPC_URL=https://test.qrdx.org/rpc
# QRDX_TEST_NODE_URL=https://test.qrdx.org

# Tokens created by these accounts can be the verified assets (bridge / foundation issuers)
# QRDX_MAIN_VERIFIED_ISSUERS=0xPQ...,0xPQ...
# QRDX_TEST_VERIFIED_ISSUERS=0xPQ...

# Or pin verified assets to token addresses directly
# QRDX_MAIN_ASSET_ADDRESSES={"btc":"0x...","usdc":"0x...","qrdx":"0x..."}
# QRDX_TEST_ASSET_ADDRESSES={"btc":"0x...","usdc":"0x...","qrdx":"0x..."}

# QRDX Connect (phone wallet by QR code; docs/CONNECT.md)
# NEXT_PUBLIC_QRDX_RELAY_URL=https://trade.qrdx.org/api/relay     # default: this site's /api/relay
# NEXT_PUBLIC_QRDX_WALLET_URL=https://wallet.qrdx.org            # where pairing links open the wallet
