{
  "name": "qrdx-trade",
  "version": "1.0.0",
  "description": "QRDX Trade - Quantum Resistant DEX Trading Interface",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:nobun": "pnpm exec next build",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && node scripts/deploy-relay.mjs",
    "start": "next start",
    "lint": "next lint",
    "deploy": "pnpm run build:worker && opennextjs-cloudflare deploy",
    "deploy:preview": "QRDX_SKIP_RELAY_DEPLOY=1 opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "clean": "rm -rf .next node_modules .open-next .wrangler",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc --port 8787",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc",
    "relay:typecheck": "tsc --noEmit -p relay/tsconfig.json",
    "nft-market:compile": "node scripts/nft-market/compile.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwindcss",
    "shadcn",
    "dex",
    "trading",
    "quantum-resistant"
  ],
  "author": "QRDX Foundation",
  "license": "ISC",
  "packageManager": "pnpm@10.6.4",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "11.11.17",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.552.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-tsparticles": "^2.12.2",
    "recharts": "^3.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@opennextjs/cloudflare": "1.20.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.3",
    "solc": "0.8.28",
    "typescript": "^5.7.2",
    "vitest": "^3",
    "wrangler": "4.143.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "packageExtensions": {
      "@opennextjs/cloudflare@1.20.7": {
        "dependencies": {
          "esbuild": "0.25.4"
        }
      }
    }
  }
}
