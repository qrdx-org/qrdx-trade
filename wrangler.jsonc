{
  // QRDX Trade as one Cloudflare Worker (worker.ts): the Next.js app, built by the OpenNext
  // adapter (@opennextjs/cloudflare) into .open-next/, and the site's stateful services from
  // relay/ (QRDX Connect relay, market history, profiles, the NFT market registry) under
  // /api/relay, /api/history and /api/profiles. `pnpm deploy` builds and deploys it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrdx-trade",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Wrangler's default keeps function names with an `__name` helper, which then leaks into
  // the inline scripts Next renders (the theme script) and throws in the browser.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelaySession" },
      { "name": "HISTORY", "class_name": "MarketHistory" },
      { "name": "PROFILES", "class_name": "Profiles" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySession", "MarketHistory", "Profiles"] }],
  // Record every network's pools once a minute (market history).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "NETWORKS": "{\"mainnet\":\"https://rpc.qrdx.org\",\"testnet\":\"https://test.qrdx.org/rpc\"}"
  },
  // The app's server code calls the services in this same Worker through this binding (a Worker
  // cannot fetch() its own routes over the network); OpenNext's caches use it too.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "qrdx-trade" }],
  "routes": [{ "pattern": "trade.qrdx.org/*", "zone_name": "qrdx.org" }],
  "observability": { "enabled": true }
}
