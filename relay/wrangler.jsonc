{
  // LOCAL DEVELOPMENT ONLY (pnpm relay:dev): the site's stateful services on their own, for
  // `next dev` to use. In production they run inside the site's Worker (../worker.ts,
  // ../wrangler.jsonc); this file is never deployed.
  "name": "qrdx-relay-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelaySession" },
      { "name": "HISTORY", "class_name": "MarketHistory" },
      { "name": "PROFILES", "class_name": "Profiles" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelaySession"] },
    { "tag": "v2", "new_sqlite_classes": ["MarketHistory"] },
    { "tag": "v3", "new_sqlite_classes": ["Profiles"] }
  ],
  // Record every network's pools once a minute.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "NETWORKS": "{\"mainnet\":\"https://rpc.qrdx.org\",\"testnet\":\"https://test.qrdx.org/rpc\"}"
  },
  "observability": { "enabled": true }
}
